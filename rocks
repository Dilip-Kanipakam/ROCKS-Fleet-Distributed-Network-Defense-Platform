#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ -x "$ROOT_DIR/.venv/bin/python" ]]; then
  exec "$ROOT_DIR/.venv/bin/python" -m rocks "$@"
fi

if command -v python3 >/dev/null 2>&1; then
  exec python3 -m rocks "$@"
fi

printf 'ROCKS requires Python 3.10 or newer to run from the repository wrapper.\n' >&2
exit 1
